# Copy this file to `.env` for local development/release builds.
# Do not commit or distribute the populated `.env` file.
#
# Android's AdMob APPLICATION_ID is configured separately in:
# android/app/src/main/res/values/strings.xml

# Production ad unit IDs used only by release builds.
BANNER_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
REWARDED_AD_UNIT_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Optional: local Google Mobile Ads test-device ID for development.
TEST_DEVICE_ID=
